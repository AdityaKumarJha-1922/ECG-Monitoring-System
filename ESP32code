#include <WiFi.h>
#include <PubSubClient.h>
 
#define WIFISSID "*****" // Put your WifiSSID here
#define PASSWORD "*****" // Put your wifi password here
#define TOKEN "*****" // Put your Ubidots' TOKEN
#define MQTT_CLIENT_NAME "*******" // MQTT client Name, please enter your own 8-12 alphanumeric character ASCII string; 
                                           //it should be a random and unique ascii string and different from all other devices
 
/****************************************
 * Define Constants
 ****************************************/
#define VARIABLE_LABEL "sensor" // Assing the variable label
#define DEVICE_LABEL "esp32" // Assig the device label
 
#define SENSOR A0 // Set the A0 as SENSOR
 
char mqttBroker[]  = "industrial.api.ubidots.com";
char payload[200];
char topic[150];
// Space to store values to send
char str_sensor[10];
char str_heartRate[10];
char str_status[20];

/****************************************
 * Heart Rate Detection Variables
 ****************************************/
#define THRESHOLD 2000 // Threshold for peak detection (adjust based on your sensor)
#define SAMPLE_WINDOW 20000 // 20 seconds window for heart rate calculation (ms)
#define MIN_PEAK_DISTANCE 300 // Minimum distance between peaks (ms) - prevents double counting

unsigned long lastBeatTime = 0;
unsigned long beatTimes[10]; // Store last 10 beat timestamps
int beatIndex = 0;
int beatCount = 0;
float heartRate = 0;
bool isPeakDetected = false;
int lastSensorValue = 0;
String heartRateStatus = "Calculating...";
 
/****************************************
 * Auxiliar Functions
 ****************************************/
WiFiClient ubidots;
PubSubClient client(ubidots);
 
void callback(char* topic, byte* payload, unsigned int length) {
  char p[length + 1];
  memcpy(p, payload, length);
  p[length] = NULL;
  Serial.write(payload, length);
  Serial.println(topic);
}
 
void reconnect() {
  // Loop until we're reconnected
  while (!client.connected()) {
    Serial.println("Attempting MQTT connection...");
    
    // Attemp to connect
    if (client.connect(MQTT_CLIENT_NAME, TOKEN, "")) {
      Serial.println("Connected");
    } else {
      Serial.print("Failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 2 seconds");
      // Wait 2 seconds before retrying
      delay(2000);
    }
  }
}
 
/****************************************
 * Heart Rate Detection Functions
 ****************************************/
void detectHeartRate(float sensorValue) {
  unsigned long currentTime = millis();

  // Peak detection: looking for signal crossing above threshold
  if (sensorValue > THRESHOLD && lastSensorValue <= THRESHOLD && !isPeakDetected) {
    // Check if enough time has passed since last beat (avoid double counting)
    if (currentTime - lastBeatTime > MIN_PEAK_DISTANCE) {
      // Store beat time
      beatTimes[beatIndex] = currentTime;
      beatIndex = (beatIndex + 1) % 10;

      if (beatCount < 10) {
        beatCount++;
      }

      lastBeatTime = currentTime;
      isPeakDetected = true;

      // Calculate heart rate if we have enough beats
      if (beatCount >= 2) {
        // Calculate average time between beats
        unsigned long totalInterval = 0;
        int intervals = 0;

        for (int i = 1; i < beatCount; i++) {
          int prevIndex = (beatIndex - i - 1 + 10) % 10;
          int currIndex = (beatIndex - i + 10) % 10;

          if (beatTimes[currIndex] > beatTimes[prevIndex]) {
            totalInterval += (beatTimes[currIndex] - beatTimes[prevIndex]);
            intervals++;
          }
        }

        if (intervals > 0) {
          float avgInterval = totalInterval / (float)intervals;
          heartRate = 60000.0 / avgInterval; // Convert ms to BPM

          // Classify heart rate as normal or abnormal
          // Normal adult resting heart rate: 60-100 BPM
          // Athletes: 40-60 BPM
          // Children: up to 120 BPM
          // Using 60-100 BPM as normal range for adults

          if (heartRate >= 60 && heartRate <= 100) {
            heartRateStatus = "Normal";
          } else if (heartRate < 60 && heartRate > 40) {
            heartRateStatus = "Low (Bradycardia)";
          } else if (heartRate > 100 && heartRate < 150) {
            heartRateStatus = "High (Tachycardia)";
          } else if (heartRate <= 40) {
            heartRateStatus = "Very Low";
          } else if (heartRate >= 150) {
            heartRateStatus = "Very High";
          } else {
            heartRateStatus = "Abnormal";
          }
        }
      }
    }
  } else if (sensorValue <= THRESHOLD) {
    isPeakDetected = false;
  }

  lastSensorValue = sensorValue;
}

/****************************************
 * Main Functions
 ****************************************/
void setup() {
  Serial.begin(115200);
  WiFi.begin(WIFISSID, PASSWORD);
  // Assign the pin as INPUT 
  pinMode(SENSOR, INPUT);
 
  Serial.println();
  Serial.print("Waiting for WiFi...");
  
  while (WiFi.status() != WL_CONNECTED) {
    Serial.print(".");
    delay(500);
  }
  
  Serial.println("");
  Serial.println("WiFi Connected");
  Serial.println("IP address: ");
  Serial.println(WiFi.localIP());
  client.setServer(mqttBroker, 1883);
  client.setCallback(callback);  
}
 
void loop() {
  if (!client.connected()) {
    reconnect();
  }
 
  sprintf(topic, "%s%s", "/v1.6/devices/", DEVICE_LABEL);
  sprintf(payload, "%s", ""); // Cleans the payload

  float sensor = analogRead(SENSOR);

  // Detect heart rate from ECG signal
  detectHeartRate(sensor);

  /* 4 is mininum width, 2 is precision; float value is copied onto str_sensor*/
  dtostrf(sensor, 4, 2, str_sensor);
  dtostrf(heartRate, 4, 2, str_heartRate);
  heartRateStatus.toCharArray(str_status, 20);

  // Build JSON payload with sensor value, heart rate, and status
  sprintf(payload, "{\"%s\": {\"value\": %s}, \"heart_rate\": {\"value\": %s}, \"hr_status\": {\"value\": \"%s\"}}",
          VARIABLE_LABEL, str_sensor, str_heartRate, str_status);

  Serial.println("Publishing data to Ubidots Cloud");
  Serial.print("Heart Rate: ");
  Serial.print(heartRate);
  Serial.print(" BPM - Status: ");
  Serial.println(heartRateStatus);

  client.publish(topic, payload);
  client.loop();
  delay(500);
}
